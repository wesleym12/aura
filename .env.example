# Configuracao da A.U.R.A. O instalador (instalar.ps1 no Windows, instalar.sh no Linux) cria o .env a partir
# deste arquivo, analisa o computador e preenche o que precisa. O resto (chaves, contas, modelos da nuvem)
# se configura pela tela.

# ---- O que sobe (o instalador escolhe) ----
# Windows: docker-compose.yml;docker-compose.windows.yml[;docker-compose.gpu.yml]   (separador ;)
# Linux:   docker-compose.yml:docker-compose.linux.yml[:docker-compose.gpu.yml]     (separador :)
COMPOSE_FILE=
# "casa" = sobe o Home Assistant junto (deixe vazio se ja tiver um, como o app do umbrelOS)
COMPOSE_PROFILES=

# ---- Cerebro ----
# 1 = modelo local no Ollama (precisa de placa de video para ficar rapido); 0 = so Gemini (precisa da chave abaixo)
AURA_LOCAL_LLM=1
# 6 GB de video: qwen3:4b-instruct; 4 GB ou CPU forte: qwen3:1.7b; mais de 8 GB: qwen3:8b
OLLAMA_MODEL=qwen3:4b-instruct
# Chave do Gemini (Gemini Live, imagens, "so Gemini"). Tambem pode ser colada na tela. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# OLLAMA_CONTEXT_LENGTH=8192
# EMBED_MODEL=paraphrase-multilingual
# VISION_MODEL=qwen3-vl:2b-instruct

# ---- Pastas e sistema ----
# Pasta do computador que a A.U.R.A. pode usar; dentro dela voce escolhe a pasta de trabalho pela tela
WORK_ROOT=
TZ=America/Sao_Paulo

# ---- Acesso ----
# 127.0.0.1 = so nesta maquina (Windows, padrao). 0.0.0.0 = pela rede (servidor/umbrelOS): exige AURA_PASSWORD.
AURA_BIND=127.0.0.1
# Senha da tela de login (vazia = sem login; so use vazia com AURA_BIND=127.0.0.1)
AURA_PASSWORD=
# 1 = HTTPS com certificado proprio (necessario para o microfone funcionar a partir de outro aparelho)
AURA_TLS=0
# Nomes/IPs do certificado e endereco publico (usado no login do Spotify). Ex.: umbrel.local,192.168.0.10
AURA_TLS_NAMES=
AURA_PUBLIC_URL=

# ---- Windows ----
# Chave secreta entre a A.U.R.A. e o agente do Windows (gerada pelo instalador; nao compartilhe)
HOST_AGENT_TOKEN=
# 1 = so simula desligar/reiniciar/Wi-Fi/cliques (para testar sem mexer no PC)
AURA_POWER_DRYRUN=0
# Pasta do projeto, se o "Iniciar com o Windows" nao a descobrir sozinho
# AURA_DIR_WIN=C:\caminho\da\aura

# ---- Voz ----
# WHISPER_MODEL=small        (base = mais leve, medium = mais preciso)

# ---- Opcionais ----
AGENT_TIMEOUT=600
# Token de longa duracao do Claude (`claude setup-token`); ou faca o login pela tela (Configuracoes -> Contas)
CLAUDE_CODE_OAUTH_TOKEN=
