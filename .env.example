# Configuracao da A.U.R.A. O iniciar.ps1 cria o .env a partir deste arquivo na primeira vez e preenche
# sozinho WORK_ROOT (sua pasta de usuario) e HOST_AGENT_TOKEN (chave do agente do Windows).
# O resto (chaves de API, modelos da nuvem, contas) e configurado pela tela.

# ---- Windows ----
# Pasta do Windows que a A.U.R.A. enxerga; dentro dela voce escolhe a pasta de trabalho pela tela
WORK_ROOT=
# Chave secreta entre a A.U.R.A. e o agente do Windows (nao compartilhe)
HOST_AGENT_TOKEN=
TZ=America/Sao_Paulo
# 1 = so simula desligar/reiniciar/Wi-Fi/cliques (para testar sem mexer no PC)
AURA_POWER_DRYRUN=0

# ---- Modelo local (Ollama na GPU) ----
# 6 GB de video: qwen3:4b-instruct (rapido, 100% GPU) ou qwen3:8b (melhor, parte na CPU)
OLLAMA_MODEL=qwen3:4b-instruct
# OLLAMA_CONTEXT_LENGTH=8192
# EMBED_MODEL=paraphrase-multilingual
# VISION_MODEL=qwen3-vl:2b-instruct

# ---- Voz ----
# WHISPER_MODEL=small        (base = mais leve, medium = mais preciso)
# WAKE_THRESHOLD=0.5         (so para "Hey Jarvis"; aumente se disparar sozinho)

# ---- Opcionais ----
# Tempo maximo (s) de uma tarefa delegada ao Claude/Codex
AGENT_TIMEOUT=600
# Token de longa duracao do Claude (`claude setup-token`); ou faca o login pela tela (Configuracoes -> Contas)
CLAUDE_CODE_OAUTH_TOKEN=
# Gemini (Gemini Live, imagens, reserva na nuvem). Tambem pode ser colada na tela. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Pasta do projeto no Windows, se o "Iniciar com o Windows" nao a descobrir sozinho
# AURA_DIR_WIN=C:\caminho\da\aura
